{
  "name": "pawlife-mobile-appium-e2e",
  "version": "1.0.0",
  "description": "Enterprise Mobile E2E Automation Framework for Android Application (Appium 2.x + Node.js)",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json tests/**/*.test.js",
    "test:auth": "cross-env TEST_SUITE=auth mocha --config .mocharc.json tests/authentication.test.js",
    "test:forms": "cross-env TEST_SUITE=forms mocha --config .mocharc.json tests/formValidation.test.js",
    "test:nav": "cross-env TEST_SUITE=nav mocha --config .mocharc.json tests/navigation.test.js",
    "test:gestures": "cross-env TEST_SUITE=gestures mocha --config .mocharc.json tests/gesturesAndUi.test.js",
    "test:perf": "cross-env TEST_SUITE=perf mocha --config .mocharc.json tests/performance.test.js",
    "test:installed": "cross-env LAUNCH_MODE=installed mocha --config .mocharc.json tests/**/*.test.js",
    "test:apk": "cross-env LAUNCH_MODE=apk mocha --config .mocharc.json tests/**/*.test.js",
    "appium:check": "appium driver list",
    "clean:reports": "rimraf reports/screenshots/* reports/failures/* reports/excel/* excel/* logs/*"
  },
  "keywords": [
    "appium",
    "android",
    "uiautomator2",
    "mobile-automation",
    "mocha",
    "chai",
    "exceljs",
    "mochawesome",
    "winston",
    "enterprise-qa"
  ],
  "author": "Senior Mobile QA Automation Architect",
  "license": "MIT",
  "dependencies": {
    "chai": "^4.3.10",
    "chalk": "^4.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.7.3",
    "mochawesome": "^7.1.3",
    "rimraf": "^6.0.1",
    "webdriverio": "^8.39.0",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
