<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PawLife.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- Set the animated icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_paw_logo</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
